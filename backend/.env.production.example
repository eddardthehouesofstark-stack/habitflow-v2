# ═══════════════════════════════════════════════
# HabitFlow Backend - Production Environment Variables
# ═══════════════════════════════════════════════
# 
# IMPORTANT: Never commit actual .env files to Git!
# This is just a template. Copy values to your hosting platform.
#
# ═══════════════════════════════════════════════

# ─── SUPABASE CONFIGURATION ───
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── JWT SECRET ───
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# ─── SERVER CONFIGURATION ───
NODE_ENV=production
PORT=3002

# ─── FRONTEND URL (for CORS) ───
# Your deployed frontend URL
FRONTEND_URL=https://habitflow.vercel.app

# ═══════════════════════════════════════════════
# DEPLOYMENT PLATFORM INSTRUCTIONS
# ═══════════════════════════════════════════════
#
# RENDER:
# 1. Go to Dashboard → Environment
# 2. Add each variable above
# 3. Click "Save Changes"
#
# RAILWAY:
# 1. Go to Project → Variables
# 2. Click "New Variable"
# 3. Add each variable above
#
# HEROKU:
# heroku config:set SUPABASE_URL=your-url
# heroku config:set SUPABASE_SERVICE_ROLE_KEY=your-key
# heroku config:set JWT_SECRET=your-secret
# heroku config:set NODE_ENV=production
# heroku config:set FRONTEND_URL=your-frontend-url
#
# ═══════════════════════════════════════════════
